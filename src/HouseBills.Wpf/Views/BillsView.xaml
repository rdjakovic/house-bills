<UserControl x:Class="HouseBills.Wpf.Views.BillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HouseBills.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BillsViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <StackPanel DockPanel.Dock="Top" Style="{StaticResource ToolbarStyle}">
            <Button Content="New bill" Command="{Binding NewCommand}" Style="{StaticResource AccentToolbarButtonStyle}" />
            <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Record payment" Command="{Binding StartPaymentCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Mark unpaid" Command="{Binding MarkUnpaidCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Generate from recurring" Command="{Binding GenerateCommand}" Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" VerticalAlignment="Center">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" MinWidth="120" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Due from" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding DueFrom, Converter={StaticResource DateOnlyToDateTime}}" MinWidth="150" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Due to" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding DueTo, Converter={StaticResource DateOnlyToDateTime}}" MinWidth="150" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CategoryFilterId}" MinWidth="150" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Payee" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Payees}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PayeeFilterId}" MinWidth="150" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Apply" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </WrapPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Total: " Opacity="0.8" />
            <TextBlock Text="{Binding TotalAmount, StringFormat=C}" FontWeight="SemiBold" Margin="0,0,24,0" />
            <TextBlock Text="Outstanding: " Opacity="0.8" />
            <TextBlock Text="{Binding OutstandingAmount, StringFormat=C}" FontWeight="SemiBold" Foreground="{StaticResource StatusOverdueBrush}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Bills}"
                      SelectedItem="{Binding SelectedBill}"
                      Style="{StaticResource ListGridStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={StaticResource BillStatusToBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=d}" SortMemberPath="DueDate" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Payee" Binding="{Binding PayeeName}" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" SortMemberPath="Amount" />
                    <DataGridTextColumn Header="Paid on" Binding="{Binding PaidOn, StringFormat=d}" SortMemberPath="PaidOn" MinWidth="90" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=C}" SortMemberPath="PaidAmount" MinWidth="80" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bill details editor -->
            <Border Grid.Column="1"
                    Style="{StaticResource EditorPanelStyle}"
                    DataContext="{Binding Editor}"
                    Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBoxStyle}" />
                        <TextBlock Text="Payee" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Payees}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PayeeId}" Style="{StaticResource EditorComboBoxStyle}" />
                        <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CategoryId}" Style="{StaticResource EditorComboBoxStyle}" />
                        <TextBlock Text="Amount" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource EditorTextBoxStyle}" />
                        <TextBlock Text="Due date" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding DueDate, Converter={StaticResource DateOnlyToDateTime}}" Style="{StaticResource EditorDatePickerStyle}" />
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Style="{StaticResource EditorTextBoxStyle}" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource AccentToolbarButtonStyle}" />
                            <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ToolbarButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Payment editor -->
            <Border Grid.Column="1"
                    Style="{StaticResource EditorPanelStyle}"
                    DataContext="{Binding Payment}"
                    Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding Bill.Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Bill.Amount, StringFormat='Amount due: {0:C}'}" Opacity="0.8" />
                    <TextBlock Text="Paid on" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker SelectedDate="{Binding PaidOn, Converter={StaticResource DateOnlyToDateTime}}" Style="{StaticResource EditorDatePickerStyle}" />
                    <TextBlock Text="Amount paid" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource EditorTextBoxStyle}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Mark paid" Command="{Binding DataContext.ConfirmPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource AccentToolbarButtonStyle}" />
                        <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
