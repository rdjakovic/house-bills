<UserControl x:Class="HouseBills.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:HouseBills.Wpf.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HouseBills.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <StackPanel Width="340" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr Settings_Language}" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberPath="DisplayName"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{loc:Tr Settings_LanguageNote}" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
