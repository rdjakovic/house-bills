<Window x:Class="HouseBills.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HouseBills.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="HouseBills"
        Icon="/Assets/HouseBills.ico"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="8,16,8,16">
            <TextBlock DockPanel.Dock="Top" Text="HouseBills" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,16" />
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DisplayMemberPath="Title"
                     BorderThickness="0"
                     Background="Transparent" />
        </DockPanel>

        <Grid Grid.Column="1">
            <ProgressBar VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Height="3"
                         Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <ContentControl Content="{Binding CurrentPage}" Margin="24,16,24,16" Focusable="False" />
        </Grid>
    </Grid>
</Window>
