<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HouseBills.Domain\HouseBills.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HouseBills.Application.Tests" />
  </ItemGroup>

  <!-- User-facing messages (English + Messages.sr-Latn.resx). The SDK generates the strongly typed Messages class;
       public so the UI can set Messages.Culture to the chosen language. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Messages.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Messages.g.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>HouseBills.Application.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Messages</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
